{
  "name": "free-sleep",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "app",
    "server"
  ],
  "scripts": {
    "build:pr": "bun --filter server build:pr && bun --filter app build:pr",
    "lint": "bun --filter app lint && bun --filter server lint",
    "generate": "bun --filter server generate",
    "audit:prod": "bun audit --prod --audit-level=high"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "@sentry/cli",
    "esbuild",
    "msw",
    "prisma"
  ]
}
